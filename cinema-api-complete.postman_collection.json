							"raw": "{\n    \"name\": \"Studio Premium 1 Updated\",\n    \"capacity\": 150,\n    \"facilities\": \"4DX, IMAX, Dolby Atmos Sound System, Premium Seating, Air Conditioning\"\n}"
						},
						"url": {
