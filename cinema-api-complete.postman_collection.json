							"raw": "{\n    \"name\": \"New User\",\n    \"email\": \"newuser@cinema.com\",\n    \"password\": \"NewUser123!\",\n    \"role\": \"Customer\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users"]
						}
					},
					"response": []
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated User Name\",\n    \"email\": \"updated@cinema.com\",\n    \"role\": \"Customer\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "1"]
						}
					},
					"response": []
				},
				{
					"name": "Delete User (Admin Only)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users/3",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "3"]
						}
					},
					"response": []
				}
			]
		},
